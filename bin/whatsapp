    # Mapeamento em português dos navegadores / User-Agents
    USER_AGENT_LABELS_PT_BR = {
        "Default": "Padrão",
        "Windows Chrome": "Google Chrome (Windows)",
        "Windows Firefox": "Mozilla Firefox (Windows)",
        "Windows Edge": "Microsoft Edge (Windows)",
        "Mac Safari": "Apple Safari (macOS)",
        "Mac Chrome": "Google Chrome (macOS)",
        "Linux Firefox": "Mozilla Firefox (Linux)",
        "Linux Chrome": "Google Chrome (Linux)",
    }

    # Interceptador global do gettext
    orig_gettext_fn = gettext.gettext
    def deep_gettext(msg):
        if not msg:
            return msg
        res = orig_gettext_fn(msg)
        if res == msg or not res:
            if msg in GLOBAL_NATIVE_TRANSLATIONS:
                return GLOBAL_NATIVE_TRANSLATIONS[msg]
        return res

    gettext.gettext = deep_gettext
    builtins._ = deep_gettext

    local_po_dir = os.path.expanduser("~/.local/share/zapzap-patch/po")
    from zapzap.core.i18n.translation_manager import TranslationManager
    TranslationManager._locale_dir = local_po_dir

    orig_apply = TranslationManager.apply
    def patched_apply():
        orig_apply()
        try:
            t = gettext.translation(
                "zapzap",
                localedir=local_po_dir,
                languages=["pt_BR"],
                fallback=True
            )
            t.install()
        except Exception:
            pass
    TranslationManager.apply = staticmethod(patched_apply)
    TranslationManager.apply()

    # Patchear as abas de configurações
    try:
        from zapzap.features.settings.shell.settings_controller import SettingsController, SettingsPageDescriptor
        orig_pages = SettingsController._pages
        def patched_pages(self):
            pages = orig_pages(self)
            new_pages = []
            for p in pages:
                lbl = GLOBAL_NATIVE_TRANSLATIONS.get(p.label, p.label)
                new_pages.append(SettingsPageDescriptor(p.page_id, lbl, p.module_name, p.controller_name))
            return new_pages
        SettingsController._pages = patched_pages
    except Exception:
        pass

    # Patchear ComboBox para traduzir opções de User-Agent mantendo os dados intactos
    try:
        from zapzap.ui.primitives.combo_box import ComboBox
        orig_combo_add_item = ComboBox.addItem
        def patched_combo_add_item(self, text, userData=None):
            if text in USER_AGENT_LABELS_PT_BR:
                disp = USER_AGENT_LABELS_PT_BR[text]
                data = userData if userData is not None else text
                return orig_combo_add_item(self, disp, data)
            return orig_combo_add_item(self, text, userData)
        ComboBox.addItem = patched_combo_add_item

        orig_combo_find_data = ComboBox.findData
        def patched_combo_find_data(self, data, *args, **kwargs):
            idx = orig_combo_find_data(self, data, *args, **kwargs)
            if idx >= 0:
                return idx
            for i in range(self.count()):
                if self.itemData(i) == data or self.itemText(i) == data:
                    return i
            return -1
        ComboBox.findData = patched_combo_find_data
    except Exception:
        pass

    # Remoção total da opção "Apoiar o ZapZap" de toda a interface sem quebrar geometria de layouts
    try:
        from zapzap.features.settings.shell.settings_view import SettingsView
        orig_settings_setup_ui = SettingsView._setup_ui
        def patched_settings_setup_ui(self):
            orig_settings_setup_ui(self)
            if hasattr(self, "btn_donate"):
                self.btn_donate.hide()
                self.btn_donate.setVisible(False)
                self.btn_donate.setMaximumHeight(0)
        SettingsView._setup_ui = patched_settings_setup_ui

        from zapzap.features.tray.sys_tray_manager import SysTrayManager
        orig_tray_create_menu = SysTrayManager._create_menu
        def patched_tray_create_menu(self):
            menu = orig_tray_create_menu(self)
            if "donation" in self._actions:
                self._actions["donation"].setVisible(False)
                menu.removeAction(self._actions["donation"])
            return menu
        SysTrayManager._create_menu = patched_tray_create_menu

        from zapzap.ui.components.browser_sidebar import BrowserSidebar
        orig_browser_sidebar_init = BrowserSidebar.__init__
        def patched_browser_sidebar_init(self, *args, **kwargs):
            orig_browser_sidebar_init(self, *args, **kwargs)
            if hasattr(self, "btn_donations"):
                self.btn_donations.hide()
                self.btn_donations.setVisible(False)
                self.btn_donations.setMaximumHeight(0)
        BrowserSidebar.__init__ = patched_browser_sidebar_init

        from zapzap.features.settings.pages.about.view import AboutSettingsView
        orig_about_actions = AboutSettingsView._setup_actions_section
        def patched_about_actions(self):
            orig_about_actions(self)
            if hasattr(self, "donate_row"):
                self.donate_row.hide()
                self.donate_row.setVisible(False)
        AboutSettingsView._setup_actions_section = patched_about_actions

        from zapzap.features.settings.pages.notifications.view import NotificationsSettingsView
        orig_notif_setup_ui = NotificationsSettingsView._setup_ui
        def patched_notif_setup_ui(self):
            orig_notif_setup_ui(self)
            if hasattr(self, "donationMessage"):
                self.donationMessage.hide()
                self.donationMessage.setVisible(False)
        NotificationsSettingsView._setup_ui = patched_notif_setup_ui

        from zapzap.ui.components.main_window import MainWindowView
        MainWindowView.open_donations = lambda self: None

        from zapzap.core.config.settings_manager import SettingsManager
        SettingsManager.set("notifications/donation_message_enabled", False)
    except Exception:
        pass

    # 3. Ícones oficiais do WhatsApp (renderização multi-resolução nativa com QPainter)
    from PyQt6.QtGui import QPainter, QColor, QFont, QFontMetricsF, QPen, QBrush
    from PyQt6.QtCore import QRectF, Qt, QByteArray
    from PyQt6.QtSvg import QSvgRenderer
    from zapzap.assets.icons.tray_icon import TrayIcon

    # Permite executar tanto a instalação quanto o checkout do projeto.
    official_svg_paths = (
        os.path.expanduser("~/.local/share/icons/whatsapp.svg"),
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "icons", "whatsapp.svg"),
    )
    OFFICIAL_WHATSAPP_SVG = ""
    for official_svg_path in official_svg_paths:
        try:
            with open(official_svg_path, "r", encoding="utf-8") as f:
                candidate_svg = f.read()
            if QSvgRenderer(QByteArray(candidate_svg.encode("utf-8"))).isValid():
                OFFICIAL_WHATSAPP_SVG = candidate_svg
                break
        except OSError:
            continue

    # Um único desenho quadrado e proporcional em todos os tamanhos.
    OFFICIAL_WHATSAPP_SVG = OFFICIAL_WHATSAPP_SVG.replace(
        'viewBox="5 4 164 165"', 'viewBox="5 5 164 164"'
    )

    _svg_renderer = None

    def get_svg_renderer():
        global _svg_renderer
        if _svg_renderer is None and OFFICIAL_WHATSAPP_SVG:
            _svg_renderer = QSvgRenderer(QByteArray(OFFICIAL_WHATSAPP_SVG.encode("utf-8")))
        return _svg_renderer

    def render_whatsapp_pixmap(size, count=0, allow_badge=True):
        renderer = get_svg_renderer()
        if not renderer:
            pix = QPixmap(size, size)
            pix.fill(Qt.GlobalColor.transparent)
            return pix

        # Super-sampling 4x para antialiasing de alta fidelidade
        scale = 4
        high = size * scale
        pix = QPixmap(high, high)
        pix.fill(Qt.GlobalColor.transparent)

        p = QPainter(pix)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
        p.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)

        if count > 0 and allow_badge:
            # O logo mantém tamanho e centro ao receber o contador.
            renderer.render(p, QRectF(0, 0, high, high))

            text = str(count) if count < 100 else "99+"
            # Mais espaço útil para o número e menos cobertura do logo.
            badge_h = high * 0.38
            font = QFont("DejaVu Sans")
            font.setBold(True)
            font.setPixelSize(round(badge_h * 0.82))
            p.setFont(font)
            metrics = QFontMetricsF(font)
            badge_w = max(badge_h, metrics.horizontalAdvance(text) + high * 0.06)

            border_w = max(1.0, high * 0.022)
            margin = border_w / 2 + high * 0.005
            bx = high - badge_w - margin
            by = high - badge_h - margin
            rect = QRectF(bx, by, badge_w, badge_h)

            p.setPen(QPen(QColor("#ffffff"), border_w))
            p.setBrush(QBrush(QColor("#dc2626")))
            p.drawRoundedRect(rect, badge_h / 2, badge_h / 2)
            p.setPen(QColor("#ffffff"))
            p.drawText(rect, Qt.AlignmentFlag.AlignCenter, text)
        else:
            # 100% limpo, perfeitamente redondo e nítido
            renderer.render(p, QRectF(0, 0, high, high))

        p.end()
        return pix.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)

    def render_whatsapp_window_pixmap(size):
        """Mesmo logo, com respiro e pequeno recuo à direita no título."""
        if size > 22:
            return render_whatsapp_pixmap(size, allow_badge=False)
        scale = 4
        high = size * scale
        pix = QPixmap(high, high)
        pix.fill(Qt.GlobalColor.transparent)
        renderer = get_svg_renderer()
        if renderer is not None:
            painter = QPainter(pix)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)
            # Em 16 px: 2 px à esquerda, 1 px à direita e 1,5 px na vertical.
            # O logo permanece quadrado; só seu enquadramento muda.
            inset = high * (1.5 / 16)
            shift = high * (0.5 / 16)
            side = high - 2 * inset
            renderer.render(painter, QRectF(inset + shift, inset, side, side))
            painter.end()
        return pix.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio,
                          Qt.TransformationMode.SmoothTransformation)

    def create_whatsapp_clean_icon():
        """Mesmo logo para janela e barra de tarefas, com margens nos tamanhos pequenos."""
        icon = QIcon()
        for size in (16, 20, 22, 24, 32, 48, 64, 128, 256):
            icon.addPixmap(render_whatsapp_window_pixmap(size))
        return icon

    def create_whatsapp_tray_icon(count=0):
        """Ícone da bandeja com contador vermelho no canto inferior direito."""
        icon = QIcon()
        for size in (16, 20, 22, 24, 32, 48, 64, 128):
            icon.addPixmap(render_whatsapp_pixmap(size, count=count, allow_badge=True))
        return icon

    _pinned_badge_count = None
    _last_unread_count = 0
    _pinned_launcher_template = os.path.expanduser(
        "~/.local/share/plasma_icons/com.rtosta.zapzap.desktop"
    )
    _pinned_launcher_url = "file://" + os.path.expanduser(
        "~/.local/share/applications/com.rtosta.zapzap.desktop"
    )

    def _evaluate_plasma_script(script, expected):
        try:
            result = subprocess.run(
                ["qdbus6", "org.kde.plasmashell", "/PlasmaShell",
                 "org.kde.PlasmaShell.evaluateScript", script],
                stdout=subprocess.PIPE,
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=2,
                check=False,
            )
            return result.returncode == 0 and expected in result.stdout
        except Exception:
            return False

    def update_pinned_panel_badge(count):
        """Desenha a contagem no atalho superior quando ele estiver visível."""
        global _pinned_badge_count, _last_unread_count
        try:
            count = max(0, int(count or 0))
            _last_unread_count = count
            launcher_url = json.dumps(_pinned_launcher_url)
            presence_script = (
                'var p=panels().find(p=>p.location==="top" && '
                'p.widgets("org.kde.plasma.icon").some('
                f'w=>w.readConfig("url","")==={launcher_url})); '
                'print(p?"pin-present":"pin-hidden")'
            )
            if not _evaluate_plasma_script(presence_script, "pin-present"):
                return False
            if count == _pinned_badge_count:
                return True

            icon_dir = os.path.expanduser(
                "~/.local/share/icons/cambrith-whatsapp-badges"
            )
            desktop_dir = os.path.expanduser("~/.local/share/plasma_icons")
            os.makedirs(icon_dir, exist_ok=True)
            os.makedirs(desktop_dir, exist_ok=True)

            if count:
                badge_name = str(count) if count < 100 else "99plus"
                icon_path = os.path.join(icon_dir, f"whatsapp-{badge_name}.png")
                if not render_whatsapp_pixmap(256, count=count, allow_badge=True).save(icon_path, "PNG"):
                    return False
                desktop_path = os.path.join(
                    desktop_dir, f"com.rtosta.zapzap-badge-{badge_name}.desktop"
                )
                if os.path.isfile(_pinned_launcher_template):
                    with open(_pinned_launcher_template, "r", encoding="utf-8") as f:
                        desktop_data = f.read()
                    if "Icon=whatsapp" not in desktop_data:
                        return False
                    desktop_data = desktop_data.replace("Icon=whatsapp", f"Icon={icon_path}", 1)
                    with open(desktop_path, "w", encoding="utf-8") as f:
                        f.write(desktop_data)
                else:
                    return False
            else:
                desktop_path = _pinned_launcher_template

            script = (
                'var p=panels().find(p=>p.location==="top" && '
                'p.widgets("org.kde.plasma.icon").some(w=>w.readConfig("url","")==='
                f'{json.dumps(_pinned_launcher_url)})); '
                'var w=p&&p.widgets("org.kde.plasma.icon").find('
                f'w=>w.readConfig("url","")==={json.dumps(_pinned_launcher_url)}); '
                f'if(w){{w.writeConfig("localPath",{json.dumps(desktop_path)});'
                'w.reloadConfig();print("badge-updated")}'
                'else{print("pin-hidden")} '
            )
            if _evaluate_plasma_script(script, "badge-updated"):
                _pinned_badge_count = count
                return True
        except Exception:
            return False
        return False

    def set_pinned_panel_icon_visible(visible):
        """Esconde o atalho enquanto a janela está aberta e o restaura ao fechar."""
        global _pinned_badge_count
        try:
            launcher = json.dumps(_pinned_launcher_template)
            launcher_url = json.dumps(_pinned_launcher_url)
            if visible:
                script = (
                    'var p=panels().find(p=>p.location==="top"); var w=null; '
                    'if(p){w=p.widgets("org.kde.plasma.icon").find('
                    f'w=>w.readConfig("url","")==={launcher_url}); '
                    'if(!w){w=p.addWidget("org.kde.plasma.icon");'
                    f'w.writeConfig("localPath",{launcher});'
                    f'w.writeConfig("url",{launcher_url});'
                    '} } '
                    'if(w){w.reloadConfig();print("pin-visible");}'
                    'else{print("panel-missing");}'
                )
                restored = _evaluate_plasma_script(script, "pin-visible")
                if restored:
                    _pinned_badge_count = None
                    if _last_unread_count:
                        update_pinned_panel_badge(_last_unread_count)
                return restored

            script = (
                'var p=panels().find(p=>p.location==="top"); '
                'var w=p&&p.widgets("org.kde.plasma.icon").find('
                f'w=>w.readConfig("url","")==={launcher_url}); '
                'if(w){w.remove();print("pin-hidden")} '
                'else{print("pin-hidden")} '
            )
            hidden = _evaluate_plasma_script(script, "pin-hidden")
            if hidden:
                _pinned_badge_count = None
            return hidden
        except Exception:
            return False

    def create_whatsapp_window_icon(count=0):
        """Janela e barra de tarefas sempre usam o ícone limpo."""
        return create_whatsapp_clean_icon()

    # Redefine TrayIcon.getIcon para a bandeja
    TrayIcon.getIcon = staticmethod(lambda theme=TrayIcon.Type.Default, qtd=0: create_whatsapp_tray_icon(qtd))

    # A janela principal e o aplicativo definem o ícone oficial nítido assim que QApplication é criado
    orig_app_init = QApplication.__init__
    def patched_app_init(self, *args, **kwargs):
        orig_app_init(self, *args, **kwargs)
        try:
            self.setWindowIcon(create_whatsapp_clean_icon())
        except Exception:
            pass
    QApplication.__init__ = patched_app_init

    orig_app_set_icon = QApplication.setWindowIcon

    # Atualiza a contagem no atalho fixado e preserva o ícone limpo da janela.
    try:
        from zapzap.features.tray.sys_tray_manager import SysTrayManager
        def patched_sys_tray_set_icon(self, icon_type, number_notifications=0):
            # Mantém o estado do tema sem publicar um contador na barra de tarefas.
            self.current_icon = icon_type
            if not self._settings.notification_counter_enabled:
                number_notifications = 0
            update_pinned_panel_badge(number_notifications)
            # O usuário desativou a bandeja. Não atualize o SNI: isso pode
            # reexibir o ícone a cada atualização de mensagens no Plasma.
            hide_tray = getattr(self._tray, "hide", None)
            if hide_tray is not None:
                hide_tray()
            set_badge = getattr(QApplication.instance(), "setBadgeNumber", None)
            if set_badge is not None:
                set_badge(0)  # Badge azul do gerenciador de tarefas sempre desativada; o contador fica no atalho fixado.
            win_icon = create_whatsapp_window_icon()
            orig_app_set_icon(win_icon)
            for widget in QApplication.topLevelWidgets():
                if widget.isWindow():
                    widget.setWindowIcon(win_icon)
        SysTrayManager._set_icon = patched_sys_tray_set_icon
    except Exception:
        pass

    # 4. Janela principal com barra superior e controles, sem o menu interno
    from zapzap.ui.components.client_side_window import _TitleBar, ClientSideWindow
    from zapzap.ui.components.main_window import MainWindowView
    from zapzap.app.main_window_controller import MainWindowController
    from PyQt6.QtGui import QAction

    def hide_main_menubar(self):
        self.menubar.hide()
        self.menubar.setMaximumHeight(0)

    MainWindowController.settings_menubar = hide_main_menubar

    orig_titlebar_init = _TitleBar.__init__
    def patched_titlebar_init(self, window, title, button_theme, settings):
        if not title or "ZapZap" in title:
            title = title.replace("ZapZap", "WhatsApp") if title else "WhatsApp"
        orig_titlebar_init(self, window, title, button_theme, settings)
    _TitleBar.__init__ = patched_titlebar_init

    orig_main_init = MainWindowView.__init__
    def patched_main_init(self, *args, **kwargs):
        orig_main_init(self, *args, **kwargs)
        self.setWindowTitle("WhatsApp")
        self.setWindowIcon(create_whatsapp_clean_icon())
        # Mantém as decorações do KDE para mostrar título, minimizar,
        # maximizar/restaurar e fechar.
        self.setWindowFlag(Qt.WindowType.FramelessWindowHint, False)
        self.retranslate_ui()
        hide_main_menubar(self)
        # O menu fica oculto, mas os atalhos continuam ativos na janela.
        for action in self.findChildren(QAction):
            if not action.shortcut().isEmpty():
                self.addAction(action)
    MainWindowView.__init__ = patched_main_init

    orig_csr_init = ClientSideWindow.__init__
    def patched_csr_init(self, inner_window, appearance_settings=None):
        orig_csr_init(self, inner_window, appearance_settings)
        self.setWindowTitle("WhatsApp")
        self.setWindowIcon(create_whatsapp_clean_icon())
        self.title_bar.show()
        self.layout().setContentsMargins(0, 0, 0, 0)
    ClientSideWindow.__init__ = patched_csr_init

    # O atalho superior acompanha a janela: some ao abrir e retorna ao ocultar/fechar.
    orig_controller_show_event = MainWindowController.showEvent
    orig_controller_hide_event = MainWindowController.hideEvent
    orig_controller_close_event = MainWindowController.closeEvent

    def patched_controller_show_event(self, event):
        orig_controller_show_event(self, event)
        set_pinned_panel_icon_visible(False)

    def patched_controller_hide_event(self, event):
        orig_controller_hide_event(self, event)
        if not self.isMinimized():
            set_pinned_panel_icon_visible(True)

    def patched_controller_close_event(self, event):
        orig_controller_close_event(self, event)
        set_pinned_panel_icon_visible(True)

    MainWindowController.showEvent = patched_controller_show_event
    MainWindowController.hideEvent = patched_controller_hide_event
    MainWindowController.closeEvent = patched_controller_close_event

    import zapzap.app.application as zapzap_application
    orig_create_main_window = zapzap_application.create_main_window
    _quit_restore_connected = False

    def patched_create_main_window(*args, **kwargs):
        global _quit_restore_connected
        window = orig_create_main_window(*args, **kwargs)
        set_pinned_panel_icon_visible(False)
        app = QApplication.instance()
        if app is not None and not _quit_restore_connected:
            app.aboutToQuit.connect(lambda: set_pinned_panel_icon_visible(True))
            _quit_restore_connected = True
        return window

    zapzap_application.create_main_window = patched_create_main_window

    # 5. Barra de Menus da Janela Nativa (Sem distorção de atalhos e menus)
    orig_main_retranslate = MainWindowView.retranslate_ui
    def safe_retranslate_ui(self):
        orig_main_retranslate(self)
        self.setWindowTitle("WhatsApp")
        self.menuFile.setTitle("Arquivo")
        self.menuView.setTitle("Exibir")
        self.menuChat.setTitle("Conversas")
        self.menuUsers.setTitle("Contas")
        self.menuHelp.setTitle("Ajuda")
        if hasattr(self, "actionSobre_o_ZapZap"):
            self.actionSobre_o_ZapZap.setText("Sobre o WhatsApp")
        hide_main_menubar(self)
    MainWindowView.retranslate_ui = safe_retranslate_ui

    # Conta selecionada: manter o fundo discreto, sem contorno verde.
    from zapzap.ui.components.browser_page_button import BrowserPageButton
    BrowserPageButton.STYLE_SELECTED = BrowserPageButton.STYLE_SELECTED.replace(
        "border: 1px solid palette(highlight);", "border: 1px solid transparent;"
    )

    # 6. Scripts para o WhatsApp Web (DocumentCreation e Tradutor Massivo de DOM)
    from zapzap.features.browser.web.web_view import WebView
    orig_configure_profile = WebView._configure_profile

    # Script injetado no DocumentCreation: Força o ambiente web do navegador a se identificar como pt-BR nativo
    JS_LOCALE_SCRIPT = """
    (function() {
        try {
            Object.defineProperty(navigator, 'language', {
                get: () => 'pt-BR',
                configurable: true
            });
            Object.defineProperty(navigator, 'languages', {
                get: () => ['pt-BR', 'pt', 'en-US', 'en'],
                configurable: true
            });
            Object.defineProperty(navigator, 'userLanguage', {
                get: () => 'pt-BR',
                configurable: true
            });
            if (window.Intl && Intl.DateTimeFormat) {
                const origDTF = Intl.DateTimeFormat;
                window.Intl.DateTimeFormat = function(locales, options) {
                    return origDTF(locales || 'pt-BR', options);
                };
                window.Intl.DateTimeFormat.prototype = origDTF.prototype;
                window.Intl.DateTimeFormat.supportedLocalesOf = origDTF.supportedLocalesOf;
            }
        } catch(e) {}
    })();
    """

    # Script injetado no DocumentReady: Tradução massiva e contínua de todo o DOM do WhatsApp Web
