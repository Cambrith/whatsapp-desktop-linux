        orig_main_init(self, *args, **kwargs)
        self.setWindowTitle("WhatsApp")
        self.setWindowIcon(create_whatsapp_clean_icon())
        self.retranslate_ui()
    MainWindowView.__init__ = patched_main_init

    orig_csr_init = ClientSideWindow.__init__
    def patched_csr_init(self, inner_window, appearance_settings=None):
        orig_csr_init(self, inner_window, appearance_settings)
        self.setWindowTitle("WhatsApp")
        self.setWindowIcon(create_whatsapp_clean_icon())
        if hasattr(self, "title_bar") and hasattr(self.title_bar, "title_label"):
            self.title_bar.title_label.setText("WhatsApp")
        # Move a barra de menus (Arquivo, Exibir...) para a barra de título da janela
        try:
            mb = inner_window.menubar
            tb = self.title_bar
            mb.setParent(tb)
            mb.setNativeMenuBar(False)
            mb.setMaximumHeight(16777215)
            mb.setStyleSheet("QMenuBar { background: transparent; border: none; padding: 0px; } QMenuBar::item { padding: 6px 8px; margin: 2px 0px; }")
            tb._menubar_widget = mb
            tb.layout.setContentsMargins(0, 0, 0, 0)
            tb.layout.insertWidget(0, mb)
            mb.show()
        except Exception:
            pass
    ClientSideWindow.__init__ = patched_csr_init

    # Mantém a barra de menus no lugar quando a barra de título reorganiza o layout
    orig_rebuild_layout = _TitleBar._rebuild_layout
    def patched_rebuild_layout(self):
        orig_rebuild_layout(self)
        mb = getattr(self, "_menubar_widget", None)
        if mb is not None:
            self.layout.insertWidget(0, mb)
    _TitleBar._rebuild_layout = patched_rebuild_layout

    # --- Barra de título: título centralizado, botões estilo Antigravity e linha verde ---
    from PyQt6.QtCore import QPointF
    from PyQt6.QtGui import QPalette

    WA_GREEN = QColor("#04594D")
    TITLE_OFFSET_X = 12      # leve deslocamento à direita do centro exato
    BTN_W, BTN_H = 46, 40

    def _ctrl_pixmap(kind, color):
        dpr = 2
        px = QPixmap(10 * dpr, 10 * dpr)
        px.fill(Qt.GlobalColor.transparent)
        px.setDevicePixelRatio(dpr)
        pt = QPainter(px)
        pt.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        pen = QPen(color, 1.0)
        pen.setCapStyle(Qt.PenCapStyle.FlatCap)
        pt.setPen(pen)
        if kind == "min":
            pt.drawLine(QPointF(0, 5.5), QPointF(10, 5.5))
        elif kind == "max":
            pt.drawRect(QRectF(0.5, 0.5, 9, 9))
        elif kind == "restore":
            pt.drawRect(QRectF(0.5, 2.5, 7, 7))
            pt.drawLine(QPointF(2.5, 2.5), QPointF(2.5, 0.5))
            pt.drawLine(QPointF(2.5, 0.5), QPointF(9.5, 0.5))
            pt.drawLine(QPointF(9.5, 0.5), QPointF(9.5, 7.5))
            pt.drawLine(QPointF(9.5, 7.5), QPointF(7.5, 7.5))
        else:  # close
            pt.drawLine(QPointF(0, 0), QPointF(10, 10))
            pt.drawLine(QPointF(10, 0), QPointF(0, 10))
        pt.end()
        return px

    def _ctrl_icon(kind, normal, hover):
        icon = QIcon()
        icon.addPixmap(_ctrl_pixmap(kind, normal), QIcon.Mode.Normal)
        icon.addPixmap(_ctrl_pixmap(kind, hover), QIcon.Mode.Active)
        return icon

    def _style_title_buttons(tb):
        pal = tb.palette()
        fg = pal.color(QPalette.ColorRole.WindowText)
        white = QColor(255, 255, 255)
        maximized = tb.host_window.isMaximized()
        for btn, kind, hov in (
            (tb.minimize_button, "min", fg),
            (tb.maximize_button, "restore" if maximized else "max", fg),
            (tb.close_button, "close", white),
        ):
            btn.setText("")
            btn.setIcon(_ctrl_icon(kind, fg, hov))
            btn.setIconSize(QSize(10, 10))
            btn.setFixedSize(BTN_W, BTN_H)
            btn.setFocusPolicy(Qt.FocusPolicy.NoFocus)

    orig_apply_btn_theme = _TitleBar._apply_button_theme
    def patched_apply_btn_theme(self):
        orig_apply_btn_theme(self)
        _style_title_buttons(self)
    _TitleBar._apply_button_theme = patched_apply_btn_theme

    orig_csr_apply_theme = ClientSideWindow._apply_theme
    def patched_csr_apply_theme(self):
        orig_csr_apply_theme(self)
        self.setStyleSheet(self.styleSheet() + """
            QPushButton#csrWindowButton, QPushButton#csrWindowCloseButton {
                background: transparent; border: none; border-radius: 0px; padding: 0px;
            }
            QPushButton#csrWindowButton:hover { background: rgba(128, 128, 128, 55); }
            QPushButton#csrWindowButton:pressed { background: rgba(128, 128, 128, 90); }
            QPushButton#csrWindowCloseButton:hover { background: #e81123; border-top-right-radius: 8px; }
            QPushButton#csrWindowCloseButton:pressed { background: #f1707a; border-top-right-radius: 8px; }
        """)
        _style_title_buttons(self.title_bar)
    ClientSideWindow._apply_theme = patched_csr_apply_theme

    orig_csr_change = ClientSideWindow.changeEvent
    def patched_csr_change(self, event):
        orig_csr_change(self, event)
        if event.type() == QEvent.Type.WindowStateChange and hasattr(self, "title_bar"):
            _style_title_buttons(self.title_bar)
    ClientSideWindow.changeEvent = patched_csr_change

    # Botões colados na borda direita
    orig_rebuild_for_title = _TitleBar._rebuild_layout
    def patched_rebuild_title(self):
        orig_rebuild_for_title(self)
        lay = self.layout
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        # título fora do layout para poder ficar centralizado na janela inteira
        lay.removeWidget(self.title_label)
        self.title_label.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents, True)
        self.title_label.adjustSize()
        _center_title(self)
    _TitleBar._rebuild_layout = patched_rebuild_title

    def _center_title(tb):
        lbl = tb.title_label
        lbl.adjustSize()
        x = (tb.width() - lbl.width()) // 2 + TITLE_OFFSET_X
        y = (tb.height() - lbl.height()) // 2
        # nunca invadir os menus (à esquerda) nem os botões (à direita)
        mb = getattr(tb, "_menubar_widget", None)
        left_limit = (mb.geometry().right() + 24) if mb is not None else 0
        right_limit = tb.width() - 3 * BTN_W - 12
        x = max(x, left_limit)
        lbl.setVisible(x + lbl.width() <= right_limit)
        lbl.move(x, max(0, y))
        lbl.raise_()


    orig_tb_resize = _TitleBar.resizeEvent
    def patched_tb_resize(self, event):
        orig_tb_resize(self, event)
        _center_title(self)
    _TitleBar.resizeEvent = patched_tb_resize

    # Linha verde de ponta a ponta da janela (inclui as margens laterais da janela)
    class _GreenLine(QWidget):
        def paintEvent(self, _e):
            p = QPainter(self)
            p.fillRect(self.rect(), WA_GREEN)
            p.end()

    def _place_green_line(win):
        ln = getattr(win, "_wa_line", None)
        tb = getattr(win, "title_bar", None)
        if ln is None or tb is None:
            return
        y = tb.mapTo(win, QPoint(0, 0)).y() + tb.height() - 1
        ln.setGeometry(0, y, win.width(), 1)
        ln.raise_()

    orig_csr_init2 = ClientSideWindow.__init__
    def patched_csr_init2(self, *a, **k):
        orig_csr_init2(self, *a, **k)
        # Janela totalmente preenchida: sem margem transparente nem cantos vazados
        try:
            self.layout().setContentsMargins(0, 0, 0, 0)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, False)
            self.setAutoFillBackground(True)
        except Exception:
            pass
        self._wa_line = _GreenLine(self)
        self._wa_line.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents, True)
        self._wa_line.show()
        _place_green_line(self)
    ClientSideWindow.__init__ = patched_csr_init2

    def patched_csr_paint(self, _event):
        p = QPainter(self)
        p.fillRect(self.rect(), self.palette().window())
        p.end()
    ClientSideWindow.paintEvent = patched_csr_paint

    orig_csr_resize = ClientSideWindow.resizeEvent
    def patched_csr_resize(self, event):
        orig_csr_resize(self, event)
        _place_green_line(self)
    ClientSideWindow.resizeEvent = patched_csr_resize

    # Janela com barra de título própria (sem ícone) e menus fora do menu global do Plasma
    from PyQt6.QtCore import QCoreApplication
