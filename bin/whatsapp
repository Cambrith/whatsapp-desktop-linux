    # Remove qualquer menção ao aplicativo (ZapZap) e ao WhatsApp nos textos da interface nativa
    import re as _re
    _BRAND = r"(?:ZapZap|WhatsApp(?: Web)?)"
    _BRAND_EXACT = {
        "ZapZap": "Opções",
        "WhatsApp": "Opções",
        "WhatsApp Web": "Mensagens",
        "WhatsApp Web para Linux": "Aplicativo de mensagens para Linux",
        "Sobre o ZapZap": "Sobre",
        "Sobre o WhatsApp": "Sobre",
        "Configurações do ZapZap": "Configurações",
        "Bem-vindo ao ZapZap": "Bem-vindo",
        "Bloqueio do WhatsApp": "Bloqueio do aplicativo",
        "Repositório oficial do ZapZap no GitHub: rafatosta/zapzap": "Repositório oficial do aplicativo no GitHub",
        "Saiba mais sobre o ZapZap ↗": "Saiba mais ↗",
        "ZapZap {version} está disponível": "A versão {version} está disponível",
        "ZapZap {latest} está disponível. Versão atual: {current}.": "A versão {latest} está disponível. Versão atual: {current}.",
        "Ícone do aplicativo ZapZap": "Ícone do aplicativo",
    }
    def scrub_brand(t):
        if not isinstance(t, str) or not t:
            return t
        if not _re.search(r"zapzap|whatsapp", t, _re.I):
            return t
        if t in _BRAND_EXACT:
            return _BRAND_EXACT[t]
        if t.lstrip().startswith(("/", "~", "http://", "https://")):
            return t  # caminhos e URLs reais não podem ser alterados
        t = _re.sub(r"\s*[:\-–]?\s*rafatosta/zapzap", "", t)
        t = _re.sub(r"\b(do|no|ao|pelo|com o|para o|o|Do|No|Ao|Pelo|O) " + _BRAND + r"\b", lambda m: m.group(1) + " aplicativo", t)
        t = _re.sub(r"aplicativo " + _BRAND + r"\b", "aplicativo", t)
        t = _re.sub(r"^" + _BRAND + r"\b", "O aplicativo", t)
        t = _re.sub(r"\b" + _BRAND + r"\b", "aplicativo", t)
        return t

    # Interceptador global do gettext
    orig_gettext_fn = gettext.gettext
    def deep_gettext(msg):
        if not msg:
            return msg
        res = orig_gettext_fn(msg)
        if res == msg or not res:
            if msg in GLOBAL_NATIVE_TRANSLATIONS:
                res = GLOBAL_NATIVE_TRANSLATIONS[msg]
        return scrub_brand(res)

    gettext.gettext = deep_gettext
    builtins._ = deep_gettext

    from zapzap.core.i18n.translation_manager import TranslationManager
    TranslationManager._locale_dir = pkg_po

    orig_apply = TranslationManager.apply
    def patched_apply():
        orig_apply()
        # o app foi renomeado para "WhatsApp"; o catálogo continua no domínio "zapzap"
        gettext.bindtextdomain("zapzap", pkg_po)
        gettext.textdomain("zapzap")
        try:
            t = gettext.translation("zapzap", localedir=pkg_po, languages=["pt_BR"], fallback=True)
            t.install()
        except Exception:
            pass
        builtins._ = deep_gettext
    TranslationManager.apply = staticmethod(patched_apply)
    TranslationManager.apply()

    # Traduz e limpa menções também nos widgets criados com texto fixo (fora do gettext)
    from PyQt6.QtWidgets import (QLabel, QAbstractButton, QPushButton, QCheckBox, QRadioButton,
                                 QGroupBox, QMenu, QLineEdit, QTextEdit, QPlainTextEdit, QWidget)
    from PyQt6.QtGui import QAction

    _LANG_PT = {"English": "Inglês", "Arabic": "Árabe", "Bosnian": "Bósnio", "German": "Alemão",
                "Spanish": "Espanhol", "French": "Francês", "Hebrew": "Hebraico", "Hungarian": "Húngaro",
                "Italian": "Italiano", "Dutch": "Holandês", "Polish": "Polonês", "Portuguese": "Português",
                "Russian": "Russo", "Swedish": "Sueco", "Ukrainian": "Ucraniano", "Chinese": "Chinês",
                "Turkish": "Turco", "Japanese": "Japonês", "Korean": "Coreano", "Czech": "Tcheco",
                "Greek": "Grego", "Hindi": "Hindi", "Indonesian": "Indonésio", "Persian": "Persa",
                "Romanian": "Romeno", "Danish": "Dinamarquês", "Finnish": "Finlandês", "Norwegian": "Norueguês",
                "Catalan": "Catalão", "Vietnamese": "Vietnamita", "Thai": "Tailandês", "Bulgarian": "Búlgaro"}
    _TERR_PT = {"United States": "Estados Unidos", "Egypt": "Egito", "Bosnia & Herzegovina": "Bósnia e Herzegovina",
                "Germany": "Alemanha", "Spain": "Espanha", "France": "França", "Israel": "Israel",
                "Hungary": "Hungria", "Italy": "Itália", "Netherlands": "Países Baixos", "Poland": "Polônia",
                "Brazil": "Brasil", "Portugal": "Portugal", "Russia": "Rússia", "Sweden": "Suécia",
                "Ukraine": "Ucrânia", "China": "China", "United Kingdom": "Reino Unido", "Canada": "Canadá",
                "Australia": "Austrália", "Mexico": "México", "Argentina": "Argentina", "Turkey": "Turquia",
                "Japan": "Japão", "India": "Índia", "Taiwan": "Taiwan"}
    _LOC_RE = _re.compile(r"^([A-Z][a-z]+)(?: \(([^)]+)\))?( - [A-Za-z_]+)?$")
    def _pt_locale_label(text):
        m = _LOC_RE.match(text)
        if not m or m.group(1) not in _LANG_PT:
            return text
        out = _LANG_PT[m.group(1)]
        if m.group(2):
            out += " (" + _TERR_PT.get(m.group(2), m.group(2)) + ")"
        return out + (m.group(3) or "")

    def ui_text(text):
        if not isinstance(text, str) or not text:
            return text
        text = _pt_locale_label(text)
        if text in GLOBAL_NATIVE_TRANSLATIONS:
            text = GLOBAL_NATIVE_TRANSLATIONS[text]
        else:
            tr = orig_gettext_fn(text)
            if tr and tr != text:
                text = tr
        return scrub_brand(text)

    def _hook_setter(cls, name, skip_attr="_wa_keep"):
        orig = getattr(cls, name)
        def call_orig(self, *a, **k):
            if hasattr(orig, "__get__"):
                return orig.__get__(self, type(self))(*a, **k)
            return orig(self, *a, **k)
        def hooked(self, text, *a, **k):
            if not getattr(self, skip_attr, False):
                text = ui_text(text)
            return call_orig(self, text, *a, **k)
        setattr(cls, name, hooked)
        return call_orig

    def _hook_ctor(cls):
        orig = cls.__init__
        def init(self, *a, **k):
            a = list(a)
            for i, x in enumerate(a):
                if isinstance(x, str):
                    a[i] = ui_text(x)
                    break
                if not hasattr(x, "isNull") and i >= 1:
                    break
            orig(self, *a, **k)
        cls.__init__ = init

    _orig_label_settext = _hook_setter(QLabel, "setText")
    _hook_setter(QAbstractButton, "setText")
    _hook_setter(QAction, "setText")
    _hook_setter(QAction, "setToolTip")
    _hook_setter(QWidget, "setToolTip")
    _hook_setter(QLineEdit, "setPlaceholderText")
    _hook_setter(QTextEdit, "setPlaceholderText")
    _hook_setter(QPlainTextEdit, "setPlaceholderText")
    _hook_setter(QMenu, "setTitle")
    _hook_setter(QGroupBox, "setTitle")
    for _c in (QLabel, QPushButton, QCheckBox, QRadioButton, QGroupBox, QMenu, QAction):
        try:
            _hook_ctor(_c)
        except Exception:
            pass

    # Patchear as abas de configurações
    try:
        from zapzap.features.settings.shell.settings_controller import SettingsController, SettingsPageDescriptor
        orig_pages = SettingsController._pages
        def patched_pages(self):
            pages = orig_pages(self)
            new_pages = []
            for p in pages:
                lbl = GLOBAL_NATIVE_TRANSLATIONS.get(p.label, p.label)
                new_pages.append(SettingsPageDescriptor(p.page_id, lbl, p.module_name, p.controller_name))
            return new_pages
        SettingsController._pages = patched_pages
    except Exception:
        pass

    # Patchear ComboBox para traduzir opções de User-Agent mantendo os dados intactos
    try:
        from zapzap.ui.primitives.combo_box import ComboBox
        orig_combo_add_item = ComboBox.addItem
        def patched_combo_add_item(self, text, userData=None):
            if text in USER_AGENT_LABELS_PT_BR:
                disp = USER_AGENT_LABELS_PT_BR[text]
                data = userData if userData is not None else text
                return orig_combo_add_item(self, disp, data)
            if userData is not None:
                text = ui_text(text)
            return orig_combo_add_item(self, text, userData)
        ComboBox.addItem = patched_combo_add_item

        orig_combo_find_data = ComboBox.findData
        def patched_combo_find_data(self, data, *args, **kwargs):
            idx = orig_combo_find_data(self, data, *args, **kwargs)
            if idx >= 0:
                return idx
            for i in range(self.count()):
                if self.itemData(i) == data or self.itemText(i) == data:
                    return i
            return -1
        ComboBox.findData = patched_combo_find_data
    except Exception:
        pass

    # Nunca mostrar o aviso de apoio ao desenvolvimento (bloco independente dos demais)
    try:
        from zapzap.features.donation.controller import DonationController
        from zapzap.features.donation.view import DonationView
        DonationController.should_show = classmethod(lambda cls: False)
        DonationController.showMessage = staticmethod(lambda parent=None: None)
        DonationView.show = lambda self, *a, **k: None
    except Exception as _e:
        sys.stderr.write(f"Aviso: aviso de apoio não desativado: {_e}\n")

    # Remoção total da opção "Apoiar o ZapZap" de toda a interface sem quebrar geometria de layouts
    try:
        from zapzap.features.settings.shell.settings_view import SettingsView
        orig_settings_setup_ui = SettingsView._setup_ui
        def patched_settings_setup_ui(self):
            orig_settings_setup_ui(self)
            if hasattr(self, "btn_donate"):
                self.btn_donate.hide()
                self.btn_donate.setVisible(False)
                self.btn_donate.setMaximumHeight(0)
        SettingsView._setup_ui = patched_settings_setup_ui

        from zapzap.features.tray.sys_tray_manager import SysTrayManager
        orig_tray_create_menu = SysTrayManager._create_menu
        def patched_tray_create_menu(self):
            menu = orig_tray_create_menu(self)
            if "donation" in self._actions:
                self._actions["donation"].setVisible(False)
                menu.removeAction(self._actions["donation"])
            return menu
        SysTrayManager._create_menu = patched_tray_create_menu

        from zapzap.ui.components.browser_sidebar import BrowserSidebar
        orig_browser_sidebar_init = BrowserSidebar.__init__
        def patched_browser_sidebar_init(self, *args, **kwargs):
            orig_browser_sidebar_init(self, *args, **kwargs)
            if hasattr(self, "btn_donations"):
                self.btn_donations.hide()
                self.btn_donations.setVisible(False)
                self.btn_donations.setMaximumHeight(0)
        BrowserSidebar.__init__ = patched_browser_sidebar_init

        from zapzap.features.settings.pages.about.view import AboutSettingsView
        orig_about_actions = AboutSettingsView._setup_actions_section
        def patched_about_actions(self):
            orig_about_actions(self)
            if hasattr(self, "donate_row"):
                self.donate_row.hide()
                self.donate_row.setVisible(False)
        AboutSettingsView._setup_actions_section = patched_about_actions

        from zapzap.features.settings.pages.notifications.view import NotificationsSettingsView
        orig_notif_setup_ui = NotificationsSettingsView._setup_ui
        def patched_notif_setup_ui(self):
            orig_notif_setup_ui(self)
            if hasattr(self, "donationMessage"):
                self.donationMessage.hide()
                self.donationMessage.setVisible(False)
        NotificationsSettingsView._setup_ui = patched_notif_setup_ui

        from zapzap.ui.components.main_window import MainWindowView
        MainWindowView.open_donations = lambda self: None

        from zapzap.core.config.settings_manager import SettingsManager
        SettingsManager.set("notifications/donation_message_enabled", False)

    except Exception:
        pass

    # 3. Ícones oficiais do WhatsApp (renderização multi-resolução nativa com QPainter)
    from PyQt6.QtGui import QPainter, QColor, QFont, QPen, QBrush
    from PyQt6.QtCore import QRectF, Qt, QByteArray
    from PyQt6.QtSvg import QSvgRenderer
    from zapzap.assets.icons.tray_icon import TrayIcon

    official_svg_path = os.path.expanduser("~/.local/share/icons/whatsapp.svg")
    try:
        with open(official_svg_path, "r", encoding="utf-8") as f:
            OFFICIAL_WHATSAPP_SVG = f.read()
    except Exception:
        OFFICIAL_WHATSAPP_SVG = ""

    WINDOW_WHATSAPP_SVG = """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160">
<defs>
  <linearGradient id="win_g1" x1="0%" y1="0%" x2="100%" y2="100%">
    <stop offset="0%" stop-color="#2fe06e"/>
    <stop offset="100%" stop-color="#1caa46"/>
  </linearGradient>
</defs>
  <path fill="url(#win_g1)" d="M 80 12 C 42.5 12 12 42.5 12 80 C 12 92.8 15.6 104.8 21.8 115 L 14 146 L 46 138.3 C 56.1 144.4 67.8 148 80 148 C 117.5 148 148 117.5 148 80 C 148 42.5 117.5 12 80 12 Z"/>
  <path fill="#ffffff" d="M 61 46 C 59.2 46 57.4 46.7 56 48.2 C 53.8 50.4 48.5 55.6 48.5 66.2 C 48.5 76.8 56.3 87 57.4 88.5 C 58.5 90 72.8 112.2 94.7 121.7 C 112.9 129.6 116.6 128 120.5 127.6 C 124.5 127.2 133.3 122.3 135.1 117.2 C 137 112.1 137 107.7 136.4 106.8 C 135.9 105.9 134.4 105.4 132.2 104.3 C 130 103.2 119.3 97.9 117.3 97.2 C 115.3 96.5 113.8 96.1 112.4 98.3 C 110.9 100.5 106.7 105.4 105.4 106.8 C 104.1 108.3 102.8 108.5 100.6 107.4 C 98.4 106.3 91.3 103.9 82.8 96.3 C 76.2 90.4 71.7 83.2 70.4 81 C 69.1 78.8 70.3 77.6 71.4 76.5 C 72.4 75.5 73.6 73.9 74.7 72.6 C 75.8 71.3 76.2 70.4 76.9 68.9 C 77.6 67.5 77.3 66.2 76.7 65.1 C 76.2 64 72 53.8 70.2 49.5 C 68.5 45.3 66.7 45.9 65.3 45.8 L 61 46 Z"/>
</svg>"""

    _svg_renderer = None
    _win_svg_renderer = None

    def get_svg_renderer():
        global _svg_renderer
        if _svg_renderer is None and OFFICIAL_WHATSAPP_SVG:
            _svg_renderer = QSvgRenderer(QByteArray(OFFICIAL_WHATSAPP_SVG.encode("utf-8")))
        return _svg_renderer

    def get_win_svg_renderer():
        global _win_svg_renderer
        if _win_svg_renderer is None:
            # Usa o logo oficial (quadrado, sem distorção); o SVG manual só é fallback
            src = OFFICIAL_WHATSAPP_SVG or WINDOW_WHATSAPP_SVG
            _win_svg_renderer = QSvgRenderer(QByteArray(src.encode("utf-8")))
        return _win_svg_renderer

    _tray_svg_renderer = None

    def get_tray_svg_renderer():
        """Logo recortado rente ao balão verde (sem a margem do SVG) para
        preencher a bandeja e aparecer maior."""
        global _tray_svg_renderer
        if _tray_svg_renderer is None and OFFICIAL_WHATSAPP_SVG:
            _tray_svg_renderer = QSvgRenderer(QByteArray(OFFICIAL_WHATSAPP_SVG.encode("utf-8")))
            _tray_svg_renderer.setViewBox(QRectF(9.5, 10.5, 154, 154))
        return _tray_svg_renderer

    def render_whatsapp_pixmap(size, count=0, allow_badge=True):
        renderer = get_tray_svg_renderer()
        if not renderer:
            return QPixmap(size, size)

        # Super-sampling 4x para antialiasing de alta fidelidade
        scale = 8
        high = size * scale
        pix = QPixmap(high, high)
        pix.fill(Qt.GlobalColor.transparent)

        p = QPainter(pix)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
        p.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)

        # Logo ocupa 100% da area (maior na bandeja); o badge sobrepoe o canto superior direito
        if count > 0 and allow_badge:
            # Logo levemente menor, encostado embaixo/esquerda, deixando o canto superior direito livre pro balão
            renderer.render(p, QRectF(0, high * 0.04, high * 0.96, high * 0.96))
        else:
            renderer.render(p, QRectF(0, 0, high, high))

        if count > 0 and allow_badge:
            text = str(count) if count < 100 else "99+"
            badge_h = high * 0.50
            if len(text) == 1:
                badge_w = badge_h
            else:
                badge_w = badge_h * (1.0 + 0.30 * (len(text) - 1))

            bx = high - badge_w
            by = 0
            rect = QRectF(bx, by, badge_w, badge_h)

            border_w = max(2.0, high * 0.04)
            rect = rect.adjusted(border_w / 2, border_w / 2, -border_w / 2, -border_w / 2)
            p.setPen(QPen(QColor(255, 255, 255), border_w))
            p.setBrush(QBrush(QColor("#FF1F1F"))) # Vermelho vibrante
            r = rect.height() / 2.0
            p.drawRoundedRect(rect, r, r)

            p.setPen(QColor(255, 255, 255))
            font = QFont("DejaVu Sans, Arial, sans-serif")
            font.setBold(True)
            font.setPixelSize(int(badge_h * (0.74 if len(text) == 1 else 0.62)))
            p.setFont(font)
            p.drawText(rect, Qt.AlignmentFlag.AlignCenter, text)

        p.end()
        return pix.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)

    def render_whatsapp_window_pixmap(size):
        """Renderiza o design de janela otimizado de altíssima nitidez e contraste."""
        renderer = get_win_svg_renderer()
        scale = 4
        high = size * scale
        pix = QPixmap(high, high)
        pix.fill(Qt.GlobalColor.transparent)
        p = QPainter(pix)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
        renderer.render(p, QRectF(0, 0, high, high))
        p.end()
        return pix.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)

    def create_whatsapp_clean_icon():
        """Ícone oficial para a janela (versão otimizada) e sistema."""
        icon = QIcon()
        for size in (16, 20, 22, 24, 32, 48, 64, 128, 256):
            icon.addPixmap(render_whatsapp_window_pixmap(size))
        return icon

    _wa_state = {"dnd": False, "count": 0}

    def create_whatsapp_tray_icon(count=0):
        """Ícone da bandeja do sistema com badge vermelho ligeiramente deslocado à esquerda.
        Em modo Não Perturbe o badge nunca é mostrado."""
        icon = QIcon()
        show_badge = count > 0 and not _wa_state["dnd"]
        for size in (16, 18, 20, 22, 24, 26, 28, 30, 32, 36, 40, 44, 48, 56, 64, 72, 96, 128):
            icon.addPixmap(render_whatsapp_pixmap(size, count=count, allow_badge=show_badge))
        return icon

    def create_whatsapp_window_icon(count=0):
        """Ícone para janela e barra de tarefas:
        - Tamanhos 16 e 22 (barra de títulos/menu da janela) usam a versão otimizada limpa.
        - Tamanhos >= 24 (barra de tarefas e dock) usam o badge com notificação.
        """
        # O ícone da barra de tarefas/janela nunca mostra notificações:
        # somente o ícone da bandeja (painel superior) exibe o balão vermelho.
        return create_whatsapp_clean_icon()

    # Redefine TrayIcon.getIcon para a bandeja
    TrayIcon.getIcon = staticmethod(lambda theme=TrayIcon.Type.Default, qtd=0: create_whatsapp_tray_icon(qtd))

    # A janela principal e o aplicativo definem o ícone oficial nítido assim que QApplication é criado
    # --- Modo Não Perturbe: sem balão vermelho e sem nenhum som (mensagens e chamadas) ---
    import weakref
    from PyQt6.QtCore import QTimer
    from PyQt6.QtDBus import QDBusConnection, QDBusInterface
    from PyQt6.QtWebEngineCore import QWebEnginePage

    _wa_pages = weakref.WeakSet()
    orig_page_init = QWebEnginePage.__init__
    def patched_page_init(self, *a, **k):
        orig_page_init(self, *a, **k)
        self._wa_want_muted = False
        try:
            _wa_pages.add(self)
            if _wa_state["dnd"]:
                _call_page(self, "setAudioMuted", True)
        except Exception:
            pass
    QWebEnginePage.__init__ = patched_page_init

    _orig_page_set_muted = QWebEnginePage.setAudioMuted
    def _call_page(page, name, value):
        fn = _orig_page_set_muted
        if hasattr(fn, "__get__"):
            return fn.__get__(page, type(page))(value)
        return fn(page, value)
    def patched_set_audio_muted(self, muted):
        self._wa_want_muted = bool(muted)
        return _call_page(self, "setAudioMuted", bool(muted) or _wa_state["dnd"])
    QWebEnginePage.setAudioMuted = patched_set_audio_muted

    def _wa_apply_dnd(dnd):
        _wa_state["dnd"] = dnd
        for pg in list(_wa_pages):
            try:
                _call_page(pg, "setAudioMuted", bool(getattr(pg, "_wa_want_muted", False)) or dnd)
            except Exception:
                pass
        try:
            from zapzap.features.tray.sys_tray_manager import SysTrayManager as _STM
            _inst = _STM.instance()
            _inst._tray.setIcon(create_whatsapp_tray_icon(_wa_state["count"]))
        except Exception:
            pass

    def _wa_start_dnd_monitor(app):
        iface = QDBusInterface("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                               "org.freedesktop.DBus.Properties", QDBusConnection.sessionBus())
        def tick():
            try:
                r = iface.call("Get", "org.freedesktop.Notifications", "Inhibited")
                args = r.arguments()
                dnd = bool(args[0]) if args else False
            except Exception:
                return
            if dnd != _wa_state["dnd"]:
                _wa_apply_dnd(dnd)
            elif dnd:
                _wa_apply_dnd(True)  # reforça o mudo em páginas novas
        timer = QTimer(app)
        timer.timeout.connect(tick)
        timer.start(1500)
        app._wa_dnd_timer = timer
        app._wa_dnd_iface = iface
        tick()

    orig_app_init = QApplication.__init__
    def patched_app_init(self, *args, **kwargs):
        orig_app_init(self, *args, **kwargs)
        try:
            self.setWindowIcon(create_whatsapp_clean_icon())
        except Exception:
            pass
        try:
            _wa_start_dnd_monitor(self)
        except Exception:
            pass
    QApplication.__init__ = patched_app_init

    orig_app_set_icon = QApplication.setWindowIcon

    # Conectar notificações para atualizar a bandeja e a barra de tarefas
    try:
        from zapzap.features.tray.sys_tray_manager import SysTrayManager
        orig_sys_tray_set_icon = SysTrayManager._set_icon
        def patched_sys_tray_set_icon(self, icon_type, number_notifications=0):
            orig_sys_tray_set_icon(self, icon_type, number_notifications)
            _wa_state["count"] = number_notifications
            self._tray.setIcon(create_whatsapp_tray_icon(number_notifications))
            win_icon = create_whatsapp_window_icon(number_notifications)
            orig_app_set_icon(win_icon)
            for widget in QApplication.topLevelWidgets():
                if widget.isWindow():
                    widget.setWindowIcon(win_icon)
        SysTrayManager._set_icon = patched_sys_tray_set_icon
    except Exception:
        pass

    # 4. Título da Janela e Barra Superior
    from zapzap.ui.components.client_side_window import _TitleBar, ClientSideWindow
    from zapzap.ui.components.main_window import MainWindowView

    orig_titlebar_init = _TitleBar.__init__
    def patched_titlebar_init(self, window, title, button_theme, settings):
        if not title or "ZapZap" in title:
            title = title.replace("ZapZap", "WhatsApp") if title else "WhatsApp"
        orig_titlebar_init(self, window, title, button_theme, settings)
        self.title_label._wa_keep = True
        _orig_label_settext(self.title_label, "WhatsApp")
    _TitleBar.__init__ = patched_titlebar_init

