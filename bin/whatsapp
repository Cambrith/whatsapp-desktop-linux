            '90 days': '90 dias',
            'Everyone': 'Todos',
            'My contacts': 'Meus contatos',
            'Nobody': 'Ninguém',
            'My contacts except...': 'Meus contatos, exceto...',

            // Chamadas e Mídia
            'Voice call': 'Chamada de voz',
            'Video call': 'Chamada de vídeo',
            'Incoming call': 'Chamada recebida',
            'Missed call': 'Chamada perdida',
            'Declined call': 'Chamada recusada',
            'Ongoing call': 'Chamada em andamento',
            'End call': 'Encerrar chamada',
            'Mute microphone': 'Desativar microfone',
            'Unmute microphone': 'Ativar microfone',
            'Turn off camera': 'Desativar câmera',
            'Turn on camera': 'Ativar câmera',
            'Photos': 'Fotos',
            'Videos': 'Vídeos',
            'Documents': 'Documentos'
        };

        const REGEX_PATTERNS = [
            { reg: /^last seen today at (.*)$/i, rep: 'visto por último hoje às $1' },
            { reg: /^last seen yesterday at (.*)$/i, rep: 'visto por último ontem às $1' },
            { reg: /^last seen (.*)$/i, rep: 'visto por último em $1' },
            { reg: /^today at (.*)$/i, rep: 'hoje às $1' },
            { reg: /^yesterday at (.*)$/i, rep: 'ontem às $1' },
            { reg: /\bZapZap\b/g, rep: 'WhatsApp' }
        ];

        function translateString(str) {
            if (!str) return str;
            const trimmed = str.trim();
            if (DICT_EXACT[trimmed]) {
                return str.replace(trimmed, DICT_EXACT[trimmed]);
            }
            for (const p of REGEX_PATTERNS) {
                if (p.reg.test(trimmed)) {
                    return str.replace(p.reg, p.rep);
                }
            }
            return null;
        }

        const ATTR_NAMES = ['placeholder', 'title', 'aria-label', 'alt'];

        function translateElementAttributes(el) {
            if (!el || !el.getAttribute) return;
            for (const attr of ATTR_NAMES) {
                const val = el.getAttribute(attr);
                if (val) {
                    const trans = translateString(val);
                    if (trans && trans !== val) {
                        el.setAttribute(attr, trans);
                    }
                }
            }
        }

        function translateDom() {
            if (!document.body) return;

            // 1. Traduz nós de texto visíveis
            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
            let node;
            while (node = walker.nextNode()) {
                const val = node.nodeValue;
                if (val && val.trim().length > 0) {
                    const trans = translateString(val);
                    if (trans && trans !== val) {
                        node.nodeValue = trans;
                    }
                }
            }

            // 2. Traduz atributos dos elementos
            const elements = document.body.querySelectorAll('[placeholder], [title], [aria-label], [alt]');
            for (let i = 0; i < elements.length; i++) {
                translateElementAttributes(elements[i]);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', translateDom);
        } else {
            translateDom();
        }

        // Observação contínua para novos elementos dinâmicos
        const observer = new MutationObserver(() => {
            translateDom();
        });
        observer.observe(document.documentElement, {
            childList: true,
            subtree: true,
            characterData: true,
            attributes: true,
            attributeFilter: ['placeholder', 'title', 'aria-label', 'alt']
        });

        setInterval(translateDom, 1200);
    })();
    """

    def patched_configure_profile(self):
        orig_configure_profile(self)
        if self.profile:
            self.profile.setHttpAcceptLanguage("pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7")
            try:
                # 1. Injeta script no DocumentCreation para assegurar locale pt-BR nativo do navegador
                s_locale = QWebEngineScript()
                s_locale.setName("whatsapp_web_pt_br_locale")
                s_locale.setInjectionPoint(QWebEngineScript.InjectionPoint.DocumentCreation)
                s_locale.setRunsOnSubFrames(True)
                s_locale.setWorldId(QWebEngineScript.ScriptWorldId.MainWorld)
                s_locale.setSourceCode(JS_LOCALE_SCRIPT)
                self.profile.scripts().insert(s_locale)

                # 2. Injeta tradutor massivo contínuo no DocumentReady
                s_trans = QWebEngineScript()
                s_trans.setName("whatsapp_web_pt_br_massive_translator")
                s_trans.setInjectionPoint(QWebEngineScript.InjectionPoint.DocumentReady)
                s_trans.setRunsOnSubFrames(True)
                s_trans.setWorldId(QWebEngineScript.ScriptWorldId.MainWorld)
                s_trans.setSourceCode(JS_MASSIVE_TRANSLATE_SCRIPT)
                self.profile.scripts().insert(s_trans)
            except Exception:
                pass
    WebView._configure_profile = patched_configure_profile

except Exception as e:
    sys.stderr.write(f"Aviso: falha ao aplicar patch do WhatsApp: {e}\n")

from zapzap.__main__ import main
if __name__ == "__main__":
    sys.argv[0] = re.sub(r"(-script\.pyw|\.exe)?$", "", sys.argv[0])
    sys.exit(main())
