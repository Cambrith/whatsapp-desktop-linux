    from PyQt6.QtWebEngineCore import QWebEngineProfile, QWebEngineScript
except Exception:
    pass

try:
    import zapzap
    zapzap.__appname__ = "WhatsApp"

    from PyQt6.QtGui import QImage, QPixmap, QIcon
    from PyQt6.QtCore import QSize
